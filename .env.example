# Real Stripe keys — do not invent values.
# Add these in Vercel (Preview + Production) and locally as .env.local.

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Public site URL used in Checkout success/cancel links.
# On Vercel this is inferred from the deployment URL if unset.
NEXT_PUBLIC_SITE_URL=
